# VoiceTask AI - Environment Configuration

# Gemini API Key (Required on Backend)
# Never expose this in the frontend bundle or client code.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# Backend Server Port
PORT=5000

# Client Allowed Origin (CORS)
CLIENT_URL="http://localhost:8081"

# Application URL
APP_URL="MY_APP_URL"
